# Copier en .env.local. Les variables EXPO_PUBLIC_* sont intégrées à l'application :
# elles sont lisibles par n'importe qui qui décompile l'app. Jamais de secret ici.

# Sur un émulateur Android, localhost désigne l'émulateur : utiliser http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
