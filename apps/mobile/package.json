{
  "name": "@foodanalyser/mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Application mobile FoodAnalyser (iOS, Android)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.100.0",
    "expo": "~58.0.0",
    "expo-localization": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "i18next": "^26.0.0",
    "react": "19.3.0",
    "react-i18next": "^17.0.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint-plugin-i18next": "^6.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.0",
    "test-renderer": "~1.3.0",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm|((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@react-navigation/.*|react-navigation|@tanstack/.*))"
    ]
  }
}
