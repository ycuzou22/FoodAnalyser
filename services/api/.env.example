# Copier en .env et adapter. Ne jamais commiter le fichier .env.
# Valeurs de développement local uniquement (identiques à infra/docker/.env.example).

API_ENV=development
API_LOG_LEVEL=INFO

API_DATABASE_URL=postgresql+asyncpg://foodanalyser:change-me-local@localhost:5432/foodanalyser
API_REDIS_URL=redis://localhost:6379/0
API_RABBITMQ_URL=amqp://foodanalyser:change-me-local@localhost:5672/

# Liste JSON des origines autorisées (back-office en développement)
API_CORS_ORIGINS=["http://localhost:5173"]
