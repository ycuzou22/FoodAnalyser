# Variables du Docker Compose de développement.
#   cp infra/docker/.env.example infra/docker/.env
# Le fichier .env n'est jamais commité. Valeurs locales uniquement : ne jamais réutiliser
# ces mots de passe ailleurs.

POSTGRES_DB=foodanalyser
POSTGRES_USER=foodanalyser
POSTGRES_PASSWORD=change-me-local

RABBITMQ_USER=foodanalyser
RABBITMQ_PASSWORD=change-me-local

MINIO_ROOT_USER=foodanalyser
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_BUCKET=meal-photos

API_LOG_LEVEL=INFO

# Ports publiés sur 127.0.0.1 (à changer en cas de conflit avec un service déjà installé)
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
